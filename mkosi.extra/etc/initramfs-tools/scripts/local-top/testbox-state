#!/bin/sh
# testbox-state (local-top) — runs before the kernel mounts the root subvolume.
#
# If the kernel cmdline requests subvol=@runtime, delete any previous @runtime
# and create a fresh snapshot from @base. This is the structural ephemeral
# guarantee: the snapshot lives only across one boot. Crashes and power loss
# are safe — cleanup happens on the *next* boot, not at shutdown.
#
# Named-state boots (subvol=@<name>) and rescue boots (subvol=@base) pass
# through unchanged.

PREREQ=""

prereqs() {
    echo "$PREREQ"
}

case $1 in
    prereqs)
        prereqs
        exit 0
        ;;
esac

. /scripts/functions

# Find rootflags=subvol=... on the cmdline.
subvol=
for arg in $(cat /proc/cmdline); do
    case $arg in
        rootflags=*)
            for f in $(echo "${arg#rootflags=}" | tr ',' ' '); do
                case $f in
                    subvol=*) subvol=${f#subvol=} ;;
                esac
            done
            ;;
    esac
done

# Strip a leading slash if present (subvol=/@runtime is equivalent to subvol=@runtime).
case $subvol in
    /*) subvol=${subvol#/} ;;
esac

if [ -z "$subvol" ]; then
    log_warning_msg "testbox: no rootflags=subvol= on cmdline; skipping state setup"
    exit 0
fi

# Only @runtime needs preparation. Everything else passes through.
if [ "$subvol" != "@runtime" ]; then
    log_begin_msg "testbox: booting subvolume $subvol (no state setup needed)"
    log_end_msg
    exit 0
fi

wait_for_udev 10

# $ROOT may still be in cmdline form (PARTUUID=…, LABEL=…, UUID=…). Resolve
# to an actual device node before trying to mount.
dev=$(resolve_device "$ROOT" 2>/dev/null) || dev=
if [ -z "$dev" ] || [ ! -b "$dev" ]; then
    dev="$ROOT"
fi

mnt=$(mktemp -d /tmp/testbox-state.XXXXXX)
cleanup() {
    if mountpoint -q "$mnt" 2>/dev/null; then
        umount "$mnt" || true
    fi
    rmdir "$mnt" 2>/dev/null || true
}

log_begin_msg "testbox: preparing fresh @runtime from @base"

if ! mount -t btrfs -o subvol=/ "$dev" "$mnt"; then
    log_failure_msg "testbox: failed to mount $dev for state setup"
    cleanup
    panic "testbox cannot prepare @runtime"
fi

if [ ! -d "$mnt/@base" ]; then
    log_failure_msg "testbox: @base subvolume not present at top of $ROOT"
    cleanup
    panic "testbox cannot find @base"
fi

if [ -d "$mnt/@runtime" ]; then
    if ! btrfs subvolume delete "$mnt/@runtime" >/dev/null; then
        log_failure_msg "testbox: failed to delete previous @runtime"
        cleanup
        panic "testbox cannot delete previous @runtime"
    fi
fi

if ! btrfs subvolume snapshot "$mnt/@base" "$mnt/@runtime" >/dev/null; then
    log_failure_msg "testbox: failed to snapshot @base into @runtime"
    cleanup
    panic "testbox cannot snapshot @base"
fi

cleanup
log_end_msg
