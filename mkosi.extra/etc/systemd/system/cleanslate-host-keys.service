[Unit]
Description=Generate cleanslate SSH host keys on the @hostid subvolume
After=local-fs.target systemd-tmpfiles-setup.service
Before=ssh.service ssh.socket sshd.service sshd.socket

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/cleanslate-generate-host-keys

[Install]
WantedBy=multi-user.target
