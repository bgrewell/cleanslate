#!/bin/sh
# cleanslate-generate-host-keys — idempotently generate SSH host keys at
# /etc/ssh/host_keys/. Safe to run on every boot; only generates keys that
# are missing. Called by cleanslate-host-keys.service before sshd starts.

set -e

KEYDIR=/etc/ssh/host_keys
mkdir -p "$KEYDIR"
chmod 755 "$KEYDIR"

[ -f "$KEYDIR/ssh_host_rsa_key" ] || \
    ssh-keygen -t rsa -b 4096 -f "$KEYDIR/ssh_host_rsa_key" -N "" -q
[ -f "$KEYDIR/ssh_host_ecdsa_key" ] || \
    ssh-keygen -t ecdsa -b 521 -f "$KEYDIR/ssh_host_ecdsa_key" -N "" -q
[ -f "$KEYDIR/ssh_host_ed25519_key" ] || \
    ssh-keygen -t ed25519 -f "$KEYDIR/ssh_host_ed25519_key" -N "" -q

chmod 600 "$KEYDIR"/ssh_host_*_key
chmod 644 "$KEYDIR"/*.pub
